# ============================================
# Enterprise Chat RAG - Environment Variables
# ============================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production

# --- LiteLLM Proxy ---
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-master-key

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# --- Azure AI Foundry ---
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# --- Google Vertex AI ---
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-service-account.json
VERTEX_PROJECT=your-gcp-project
VERTEX_LOCATION=us-central1

# --- PostgreSQL ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=enterprise_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raguser:ragpassword@postgres:5432/enterprise_rag

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=documents

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RAG Settings ---
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
COMPLETION_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# --- OCR ---
# Provider: local (Tesseract), aws_textract, azure_di, google_docai, or auto
# "auto" tries cloud providers in order, falls back to local Tesseract
OCR_PROVIDER=local

# AWS Textract (uses same AWS creds as Bedrock above)
# No extra config needed if AWS_ACCESS_KEY_ID/SECRET are already set

# Azure Document Intelligence (formerly Form Recognizer)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Google Document AI
# Processor name format: projects/{project}/locations/{location}/processors/{processor_id}
GOOGLE_DOCAI_PROCESSOR=
