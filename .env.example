# ============================================
# Enterprise Chat RAG - Environment Variables
# ============================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-in-production

# --- LiteLLM Proxy ---
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-master-key

# --- AWS Bedrock ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# --- Azure AI Foundry ---
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.openai.azure.com/
AZURE_API_VERSION=2024-10-21

# --- Google Vertex AI ---
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcp-service-account.json
VERTEX_PROJECT=your-gcp-project
VERTEX_LOCATION=us-central1

# --- PostgreSQL ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=enterprise_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raguser:ragpassword@postgres:5432/enterprise_rag

# --- Qdrant ---
# Self-hosted (default)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Qdrant Cloud (set QDRANT_URL to use managed instance instead)
QDRANT_URL=
QDRANT_API_KEY=

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RAG Settings ---
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
COMPLETION_MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# Reranking (leave empty to disable)
# Examples: cohere-rerank, rerank-english-v3.0
RERANK_MODEL=

# --- OCR ---
# Provider: local (Tesseract), aws_textract, azure_di, google_docai, or auto
OCR_PROVIDER=local

# Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Google Document AI
GOOGLE_DOCAI_PROCESSOR=

# --- Object Storage ---
# Provider: local | s3 | gcs | azure_blob
STORAGE_PROVIDER=local
STORAGE_BUCKET=                              # S3 bucket / GCS bucket / Azure container name
AZURE_STORAGE_CONNECTION_STRING=             # Required for azure_blob

# --- Background Processing ---
USE_CELERY=false                             # true = async document processing via Celery worker
# Start worker: docker compose --profile celery up

# --- Authentication ---
AUTH_ENABLED=false                           # true = require JWT or API key
API_KEYS=                                    # Comma-separated API keys for programmatic access

# --- Observability ---
OTEL_EXPORTER_ENDPOINT=                      # e.g. http://jaeger:4317 or Datadog/New Relic endpoint

# --- Langfuse (LLM Observability) ---
LANGFUSE_ENABLED=false                       # true = enable Langfuse tracing for all LLM calls
LANGFUSE_PUBLIC_KEY=                         # From Langfuse project settings
LANGFUSE_SECRET_KEY=                         # From Langfuse project settings
LANGFUSE_HOST=https://cloud.langfuse.com     # Self-hosted: http://langfuse:3000
