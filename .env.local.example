# ============================================
# Enterprise Chat RAG - LOCAL MODE (LM Studio)
# ============================================
# Zero cloud dependency — everything runs on your machine.
#
# Usage:
#   cp .env.local.example .env
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=local-dev-secret

# --- LiteLLM Proxy ---
LITELLM_PROXY_URL=http://litellm:4000
LITELLM_MASTER_KEY=sk-litellm-local

# --- Models (matched by LiteLLM config.local.yaml) ---
COMPLETION_MODEL=default-completion
EMBEDDING_MODEL=default-embedding

# --- PostgreSQL ---
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=enterprise_rag

# --- Qdrant (local self-hosted) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RAG Settings ---
CHUNK_SIZE=512
CHUNK_OVERLAP=100
TOP_K_RESULTS=5

# --- Local options (no cloud) ---
OCR_PROVIDER=local
STORAGE_PROVIDER=local
RERANK_MODEL=
USE_CELERY=false
AUTH_ENABLED=false
LANGFUSE_ENABLED=false
OTEL_EXPORTER_ENDPOINT=
